{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetPulse",
  "version": "0.3.2",
  "identifier": "app.netpulse.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -w @netpulse/web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build -w @netpulse/web",
    "frontendDist": "../apps/web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NetPulse",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "visible": true,
        "focus": true,
        "backgroundColor": "#0b0f17"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "backend/": "backend/",
      "WebView2Loader.dll": "WebView2Loader.dll"
    },
    "publisher": "NetPulse",
    "copyright": "Copyright (c) 2026 NetPulse",
    "shortDescription": "VPN & Network Intelligence Platform",
    "longDescription": "NetPulse is a native desktop network diagnostics and VPN intelligence platform: connectivity probes, DNS lab, routing, public node intelligence, Iran connectivity analysis, gaming latency and a live global network map.",
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "exceptionDomain": ""
    },
    "linux": {}
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0M0M2ODg4RDU2ODZFQzQKUldURWJtalZpR2c4MU5vdUFvUEhQb1NteE5hdWtlSExIdXRKTmFiM0wydE5SbnZ0clVZdmxPTlMK",
      "endpoints": [
        "http://127.0.0.1:47615/api/v1/update-feed/latest.json"
      ],
      "dangerousInsecureTransportProtocol": true
    }
  }
}
