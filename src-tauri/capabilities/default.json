{
  "$schema": "gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "NetPulse main window capabilities. Deliberately minimal: dialog plugin for open/save dialogs, core defaults. No shell, no fs, no http plugins are exposed to the webview.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:event:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "updater:default"
  ]
}
