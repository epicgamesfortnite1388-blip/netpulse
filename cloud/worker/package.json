    "types": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@cloudflare/vitest-pool-workers": "^0.9.14",
    "wrangler": "^4.111.0"
  }
}
