{
  "name": "netpulse",
  "private": true,
  "version": "3.2.0",
  "description": "VPN & Network Intelligence Platform",
  "workspaces": [
    "packages/*",
    "apps/*",
    "cloud/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "npm run dev -w @netpulse/api",
    "dev:web": "npm run dev -w @netpulse/web",
    "build": "npm run build -w @netpulse/api && npm run build -w @netpulse/web",
    "test": "npm run test --workspaces --if-present",
    "test:all": "node scripts/test-all.mjs",
    "lint": "eslint packages/shared/src apps/api/src apps/web/src",
    "format": "prettier --write \"packages/**/src/**/*.{ts,tsx,css}\" \"apps/**/src/**/*.{ts,tsx,css}\"",
    "db:generate": "npm run db:generate -w @netpulse/api",
    "desktop:dev": "npm run build:desktop-backend && tauri dev",
    "desktop:package": "node scripts/desktop-package.mjs",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "release:version": "node scripts/release.mjs",
    "build:desktop-backend": "npm run build -w @netpulse/api && node scripts/prepare-desktop.mjs",
    "desktop:build": "npm run release:version && npm run build:desktop-backend && tauri build",
    "desktop:verify": "node scripts/verify-desktop-pipeline.mjs",
    "desktop:sign": "node scripts/sign-release.mjs",
    "release:feed": "node scripts/update-feed.mjs",
    "e2e": "node scripts/e2e-desktop.mjs",
    "e2e:telegram": "node scripts/e2e-telegram-vpn.mjs",
    "e2e:telegram:cloud": "node scripts/e2e-telegram-vpn.mjs --skip-vpn",
    "e2e:telegram:link:staging": "node scripts/e2e-telegram-link-staging.mjs",
    "e2e:navigation": "node scripts/verify-navigation-webview.mjs",
    "test:release": "node scripts/release-distribution.test.mjs",
    "test:signing": "node scripts/signature-trust.test.mjs",
    "test:feed": "node scripts/update-feed.test.mjs",
    "test:pipeline": "node scripts/verify-desktop-pipeline.test.mjs",
    "test:build-gates": "node scripts/build-gate-honesty.test.mjs",
    "test:deploy": "node scripts/deploy-battery.mjs",
    "test:ui-contract": "node scripts/assert-ui-contract.mjs",
    "test:ui-contract:mutants": "node scripts/verify-contract-assertions.mjs",
    "test:ui-visual": "node scripts/ui-visual-regression.mjs",
    "test:ui-visual:update": "node scripts/ui-visual-regression.mjs --update",
    "test:ui-a11y": "node scripts/ui-a11y-check.mjs",
    "test:ui-a11y:advanced": "node scripts/ui-a11y-advanced.mjs",
    "test:ui-colour": "node scripts/ui-colour-audit.mjs",
    "bench:map": "cd apps/web && NP_PERF=1 npx vitest run test/mapClusterPerf.test.ts",
    "proof:vpn": "node scripts/vpn-live-proof.mjs",
    "proof:vpn:soak": "node scripts/vpn-live-proof.mjs --soak",
    "audit:ci": "bash scripts/audit-ci.sh",
    "audit:tabs": "node scripts/audit-tab-persistence.mjs",
    "stress:nodes": "tsx scripts/stress-nodes.mjs",
    "probe:sources": "tsx scripts/free-config-probe.ts",
    "probe:connect": "tsx scripts/free-config-connect.ts",
    "probe:survival": "tsx scripts/free-config-survival.ts",
    "controls:aether": "tsx scripts/negative-controls.ts",
    "measure:stages": "tsx scripts/tunnel-stages.ts",
    "measure:dns": "tsx scripts/dns-tunnel-proof.ts",
    "test:leaks": "tsx scripts/leak-test.ts",
    "test:reconnect": "tsx scripts/reconnect-test.ts",
    "bench:engine": "tsx scripts/bench-engine-start.ts",
    "bench:bulk-probe": "tsx scripts/bench-bulk-probe.ts",
    "field:iran": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/field-iran-isp.ps1",
    "field:iran:control": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/field-iran-isp.ps1 -Arm control",
    "field:iran:plan": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/field-iran-isp.ps1 -Plan",
    "field:iran:recover": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/field-iran-isp.ps1 -Recover",
    "field:compare": "node scripts/compare-field-vantages.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "depcheck": "^1.4.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "madge": "^8.0.0",
    "ts-prune": "^0.10.3",
    "typescript-eslint": "^8.70.0"
  },
  "repository": "https://github.com/epicgamesfortnite1388-blip/netpulse",
  "netpulse": {
    "releaseFeed": "local"
  }
}
