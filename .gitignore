# Dependencies
node_modules/
src-tauri/target/
# Desktop bundle staging tree — rebuilt by scripts/prepare-desktop.mjs at
# package time; never commit generated artifacts (node.exe alone is ~92 MB).
src-tauri/backend/

# WebView2 loader is vendored next to the exe by the build, not tracked.
src-tauri/WebView2Loader.dll
src-tauri/gen/
src-tauri/Cargo.lock

# Build output
apps/api/dist/
apps/web/dist/
packages/shared/dist/

# Runtime data
.data/

# SQLite
*.db
*.db-shm
*.db-wal

# Certificates (signing keys — never commit)
certs/

# IDE / editor
.freebuff/
*.swp
*.swo
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Test artifacts
apps/api/.data-quality/

# Temporary test scripts
scripts/tmp-*.ps1
scripts/*.mjs.bak

# Desktop backend bundle output (regenerated by esbuild at package time)
apps/api/dist-desktop/

# TypeScript incremental build info
tsconfig.tsbuildinfo
*.tsbuildinfo
