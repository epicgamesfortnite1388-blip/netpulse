# Dependencies
node_modules/
src-tauri/target/
# Desktop bundle staging tree — rebuilt by scripts/prepare-desktop.mjs at
# package time; never commit generated artifacts (node.exe alone is ~92 MB).
src-tauri/backend/

# WebView2 loader is vendored next to the exe by the build, not tracked.
src-tauri/WebView2Loader.dll
src-tauri/gen/
src-tauri/Cargo.lock

# Build output
apps/api/dist/
apps/web/dist/
packages/shared/dist/

# Runtime data
.data/

# SQLite
*.db
*.db-shm
*.db-wal

# Wrangler-generated env types (regenerate with `npm run types -w
# @netpulse/cloud-worker`); the worker typechecks against
# @cloudflare/workers-types via its tsconfig, so this file is never imported.
cloud/worker/worker-configuration.d.ts

# Certificates (signing keys — never commit)
certs/

# IDE / editor
.freebuff/
*.swp
*.swo
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Test artifacts
apps/api/.data-quality/

# Temporary test scripts
scripts/tmp-*.ps1
scripts/*.mjs.bak

# Desktop backend bundle output (regenerated by esbuild at package time)
apps/api/dist-desktop/

# TypeScript incremental build info
tsconfig.tsbuildinfo
*.tsbuildinfo
# Operator credentials staged locally (never committed):
# `*token*.local` covers every shape used here (`.ops-token.local`,
# `.bot-token.local`, …) — a bare `*.token.local` would NOT match a
# dot-prefixed name like `.ops-token.local` (verified live: the file sat
# untracked-but-unignored holding a real secret).
*token*.local
