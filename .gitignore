# Dependencies
node_modules/
src-tauri/target/
# Desktop bundle staging tree — rebuilt by scripts/prepare-desktop.mjs at
# package time; never commit generated artifacts (node.exe alone is ~92 MB).
src-tauri/backend/

# WebView2 loader is vendored next to the exe by the build, not tracked.
src-tauri/WebView2Loader.dll
src-tauri/gen/
src-tauri/Cargo.lock

# Build output
apps/api/dist/
apps/web/dist/
packages/shared/dist/

# Runtime data
.data/

# SQLite
*.db
*.db-shm
*.db-wal

# Wrangler-generated env types (regenerate with `npm run types -w
# @netpulse/cloud-worker`); the worker typechecks against
# @cloudflare/workers-types via its tsconfig, so this file is never imported.
cloud/worker/worker-configuration.d.ts

# Certificates (signing keys — never commit)
certs/

# IDE / editor
.freebuff/
*.swp
*.swo
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Test artifacts
apps/api/.data-quality/

# Temporary test scripts
scripts/tmp-*.ps1
scripts/*.mjs.bak

# Desktop backend bundle output (regenerated by esbuild at package time)
apps/api/dist-desktop/

# TypeScript incremental build info
tsconfig.tsbuildinfo
*.tsbuildinfo
# Operator credentials staged locally (never committed):
# `*token*.local` covers every shape used here (`.ops-token.local`,
# `.bot-token.local`, …) — a bare `*.token.local` would NOT match a
# dot-prefixed name like `.ops-token.local` (verified live: the file sat
# untracked-but-unignored holding a real secret).
*token*.local
daemon-token

# `VPS-KEYS.txt` held the VPS SSH private key + passphrase; it was removed
# after review. If any future local file holds live credentials, ignore it
# here, never commit it, and rotate any exposed value through the service.
VPS-KEYS.txt

# Local live-proof harness token (harness-generated bearer token, never
# committed; left over from a proof run until cleaned up).
g4-boot-token.txt

# Wrangler local dev state (`.wrangler/state`, `.wrangler/tmp`): miniflare's
# D1/KV stores and logs. Regenerated by `wrangler dev`; never committed.
# (Verified the hard way: without this, a probe leaves an untracked
# `cloud/worker/.wrangler/` in `git status`.)
.wrangler/

# Local live-proof state. The VPN lifecycle harness (`scripts/vpn-live-proof.mjs`)
# mints a per-launch bearer token and generates core configs that embed node
# credentials; a leftover run therefore leaves a REAL secret on disk.
# `.silence/` (harness stdout) and `evidence/` (boot token + captures) are the
# two places it lands. Verified live: `git status` listed `?? evidence/` and
# `?? .silence/` while both held a valid token — untracked, but one `git add -A`
# away from being committed.
.silence/
/evidence/
.scratch*

# Scratch-pickerdrive harness directories (per-launch harness state + DBs +
# vault material). Leftover runs can contain real credentials.
.pickerdrive*
.pickerdrive-*/*

# Keep harness directories themselves trackable (no secret in the dir marker
# itself), but ignore the generated artifacts inside them: daemon-token, *.db,
# *.db-*, secrets.*, and secrets/ (vault keys). The nested evidence/ shape is
# covered by the recursive ignore above.

# Root-level desktop sidecar bundle (esbuild output; regenerated by
# `scripts/prepare-desktop.mjs` for the packaged app — never a source file).
/dist-desktop/

# Wrangler deploy staging output (worker bundle written by a deploy
# attempt; regenerated on demand — never a source file).
.staging-dist/

# Local scratch runs and downloaded engine binaries. `tmp/` holds throwaway
# virtualenvs and proof output; `apps/api/cores/` is populated by the engine
# installer, not source (xray.exe alone is 33 MB).
/tmp/
/apps/api/cores/
scripts/.tmp-*
__pycache__/
